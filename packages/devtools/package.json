{
  "name": "@soroform/devtools",
  "version": "0.0.0",
  "description": "Development-only devtools panel for inspecting Soroform contract read and write activity.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run build:css && tsup",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./src/styles.generated.css --minify",
    "dev": "pnpm run build:css && tsup --watch",
    "lint": "eslint .",
    "typecheck": "pnpm run build:css && tsc --noEmit",
    "test": "pnpm run build:css && vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@soroform/core": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-query-devtools": "5.102.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
